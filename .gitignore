# macOS system files
.DS_Store

# OpenCore configuration backups/duplicates
*.plist.bak
config.plist.backup
config_*.plist

# Text editor temporary files
*.swp
*.swo
*.un~
*.orig
*.rej

# OpenCore logs and debug files
opencore-*.txt
